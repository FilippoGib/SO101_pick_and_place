#usda 1.0
(
    defaultPrim = "Cube"
    metersPerUnit = 1
    upAxis = "Z"
)

# 30 mm rigid cube centered on its origin. Color is a variant because Isaac Lab skips visual-material overrides in
# kitless mode, and the Newton renderer reads only material color. Colors are authored only inside the variants,
# since local opinions would override them.
def Xform "Cube" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    variants = {
        string Color = "red"
    }
    prepend variantSets = "Color"
)
{
    # Newton does not reliably infer mass from geometry.
    float physics:mass = 0.02

    def Scope "Looks"
    {
        def Material "Plastic"
        {
            token outputs:surface.connect = </Cube/Looks/Plastic/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Mesh "geometry" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </Cube/Looks/Plastic>
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [
            (-0.015, -0.015, -0.015), (0.015, -0.015, -0.015),
            (0.015, 0.015, -0.015), (-0.015, 0.015, -0.015),
            (-0.015, -0.015, 0.015), (0.015, -0.015, 0.015),
            (0.015, 0.015, 0.015), (-0.015, 0.015, 0.015)
        ]
        token subdivisionScheme = "none"
    }

    def Cube "collision" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        bool physics:collisionEnabled = true
        double size = 1
        token purpose = "guide"
        double3 xformOp:scale = (0.03, 0.03, 0.03)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    variantSet "Color" = {
        "blue" {
            over "Looks"
            {
                over "Plastic"
                {
                    over "Shader"
                    {
                        color3f inputs:diffuseColor = (0.1, 0.3, 0.85)
                    }
                }
            }

            over "geometry"
            {
                color3f[] primvars:displayColor = [(0.1, 0.3, 0.85)]
            }
        }
        "red" {
            over "Looks"
            {
                over "Plastic"
                {
                    over "Shader"
                    {
                        color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                    }
                }
            }

            over "geometry"
            {
                color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
            }
        }
    }
}
