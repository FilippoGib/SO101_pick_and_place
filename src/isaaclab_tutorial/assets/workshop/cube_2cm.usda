#usda 1.0
(
    defaultPrim = "Cube"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cube" (
    apiSchemas = ["PhysicsRigidBodyAPI"]
) {
    def Cube "Visual" {
        double size = 1
        float3 xformOp:scale = (0.02, 0.02, 0.02)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15, 0.55, 0.95)]
    }
    def Cube "Collision" (
        apiSchemas = ["PhysicsCollisionAPI"]
    ) {
        double size = 1
        float3 xformOp:scale = (0.02, 0.02, 0.02)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        bool physics:collisionEnabled = true
    }
}
